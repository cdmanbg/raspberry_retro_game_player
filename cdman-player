#!/usr/bin/env python3
"""
cdman-player - Retro game sound player (multi-voice).

Usage:
  ./cdman-player <songname>
  ./cdman-player <songname> --tempo 240 --volume 0.02

Format:
  TEMPO 220                 (optional)
  VOLUME 0.01               (optional)

  TRACK 1 PULSE             (optional - file with no TRACK lines is one PULSE track)
  VOLUME 0.01               (optional per-track override)
  A3 4
  C4 4

  TRACK 2 TRIANGLE
  C2 2

Waveforms: PULSE (default, square ~50%), TRIANGLE, NOISE.
Noise channel ignores pitch - use 'X N' or any note name; only timing matters.
REST works in any track.
"""
import sys
import os
import json
import argparse
import numpy as np
import pygame

SAMPLE_RATE = 44100

NOTES = {
    "C0": 16.35,   "CS0": 17.32,  "D0": 18.35,   "DS0": 19.45,
