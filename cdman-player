def square_wave(freq, duration, volume):
    t = np.linspace(0, duration, int(SAMPLE_RATE * duration), False)
    wave = np.sign(np.sin(2 * np.pi * freq * t))
    fade = min(200, len(wave) // 10)
    if fade > 0:
        wave[:fade] *= np.linspace(0, 1, fade)
        wave[-fade:] *= np.linspace(1, 0, fade)
    return (wave * volume * 32767).astype(np.int16)


def play_note(note, divider, tempo, volume):
    beat = 60 / tempo
    duration = 4 / divider * beat
    if note == "REST":
        time.sleep(duration)
        return
    if note not in NOTES:
        print(f"  ! unknown note: {note} (skipping)")
        time.sleep(duration)
        return
    freq = NOTES[note]
    arr = square_wave(freq, duration, volume)
    stereo = np.column_stack((arr, arr))
    sound = pygame.sndarray.make_sound(stereo)
    sound.play()
    time.sleep(duration * 1.10)
    sound.stop()


def find_song_file(name):
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidates = [name]
    for ext in (".json", ".txt"):
        candidates.append(name + ext)
        candidates.append(os.path.join("songs", name + ext))
        candidates.append(os.path.join(script_dir, name + ext))
        candidates.append(os.path.join(script_dir, "songs", name + ext))
    for path in candidates:
        if os.path.isfile(path):
            return path
    return None


def load_song(path):
    tempo = 220
    volume = 0.01
    melody = []
    with open(path, "r") as f:
        content = f.read()
    stripped = content.strip()
    if stripped.startswith("{"):
        data = json.loads(stripped)
        tempo = data.get("tempo", tempo)
        volume = data.get("volume", volume)
        melody = [(n, d) for n, d in data["melody"]]
        return tempo, volume, melody
    for raw in content.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        key = parts[0].upper()
        if key == "TEMPO" and len(parts) >= 2:
            tempo = float(parts[1])
        elif key == "VOLUME" and len(parts) >= 2:
            volume = float(parts[1])
        elif len(parts) >= 2:
            note = parts[0].upper()
            divider = float(parts[1])
            melody.append((note, divider))
        else:
            print(f"  ! ignoring line: {raw!r}")
    return tempo, volume, melody


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("song", help="song name (with or without extension)")
    ap.add_argument("--tempo", type=float, default=None,
                    help="override song tempo (BPM)")
    ap.add_argument("--volume", type=float, default=None,
                    help="override song volume (0.0 - 1.0)")
    args = ap.parse_args()

    path = find_song_file(args.song)
    if path is None:
        print(f"Song not found: {args.song}")
        sys.exit(2)

    print(f"Loading: {path}")
    tempo, volume, melody = load_song(path)
    if args.tempo is not None:
        tempo = args.tempo
    if args.volume is not None:
        volume = max(0.0, min(1.0, args.volume))
    print(f"Tempo={tempo}  Volume={volume}  Notes={len(melody)}")

    pygame.mixer.pre_init(SAMPLE_RATE, -16, 2, 512)
    pygame.init()
    try:
        for note, dur in melody:
            play_note(note, dur, tempo, volume)
    except KeyboardInterrupt:
        print("\nStopped.")
    finally:
        pygame.quit()


if __name__ == "__main__":
    main()
