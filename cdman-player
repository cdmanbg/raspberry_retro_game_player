    "GS7": 3322.44,"A7": 3520.00, "AS7": 3729.31,"B7": 3951.07,
    "C8": 4186.01,
}

VALID_WAVES = ("PULSE", "TRIANGLE", "NOISE")


# ============================================================
# Waveform generators (return float32 in [-1, 1] at SAMPLE_RATE)
# ============================================================

def gen_pulse(freq, n_samples):
    """Square wave ~50% duty. Same as the original cdman engine."""
    t = np.arange(n_samples) / SAMPLE_RATE
    return np.sign(np.sin(2 * np.pi * freq * t)).astype(np.float32)


def gen_triangle(freq, n_samples):
    """Triangle wave - softer than square. Roughly 30-40% perceived
    loudness vs square at the same amplitude, so the NES tradition is
    to leave it at full amplitude in the mix - feels balanced."""
    t = np.arange(n_samples) / SAMPLE_RATE
    return (2 * np.abs(2 * (t * freq - np.floor(t * freq + 0.5))) - 1).astype(np.float32)


# Single shared RNG so noise sounds the same across calls
_noise_rng = np.random.default_rng(0xC0FFEE)

def gen_noise(_freq, n_samples):
    """White noise. Pitch ignored. Used for drums/percussion."""
    # uniform [-1, 1); the spectrum is flat enough for chiptune-style hits
    return (_noise_rng.random(n_samples, dtype=np.float32) * 2.0 - 1.0)


WAVE_FUNCS = {
    "PULSE":    gen_pulse,
    "TRIANGLE": gen_triangle,
    "NOISE":    gen_noise,
}


# ============================================================
# Note rendering
# ============================================================

def render_note(note, divider, tempo, wave_kind, volume):
    """Return a float32 array for one note (including its trailing gap)."""
    beat = 60.0 / tempo
    full_dur = (4.0 / divider) * beat * 1.10   # match original "* 1.10" gap
    full_samples = max(1, int(round(full_dur * SAMPLE_RATE)))
    # Sound duration is 1/1.10 of the slot, mirroring original behaviour.
    sound_samples = max(1, int(round(full_dur / 1.10 * SAMPLE_RATE)))

    buf = np.zeros(full_samples, dtype=np.float32)
    if note == "REST":
        return buf

    if wave_kind == "NOISE":
        freq = 0.0  # ignored
    else:
        freq = NOTES.get(note)
        if freq is None:
            # Unknown note (also covers things like "X" outside NOISE) -> silence.
            return buf

    wave = WAVE_FUNCS[wave_kind](freq, sound_samples) * volume

    # Fade in/out, exactly like the original (200 samples max, or 10% of length)
    fade = min(200, sound_samples // 10)
    if fade > 0:
        wave[:fade] *= np.linspace(0.0, 1.0, fade, dtype=np.float32)
        wave[-fade:] *= np.linspace(1.0, 0.0, fade, dtype=np.float32)

    buf[:sound_samples] = wave
    return buf


def render_track(notes, tempo, wave_kind, volume):
    """Concatenate rendered notes into a single float32 stream."""
    if not notes:
        return np.zeros(0, dtype=np.float32)
    parts = [render_note(n, d, tempo, wave_kind, volume) for n, d in notes]
    return np.concatenate(parts)


# ============================================================
# Song parsing
# ============================================================

def _coerce_track(line_parts):
    """'TRACK 2 TRIANGLE' -> (2, 'TRIANGLE'). 'TRACK 1' -> (1, 'PULSE')."""
    # parts[0] == 'TRACK' already
    idx = 1
    wave = "PULSE"
    if len(line_parts) >= 2:
        try:
            idx = int(line_parts[1])
        except ValueError:
            idx = 1
    if len(line_parts) >= 3:
        w = line_parts[2].upper()
        if w in VALID_WAVES:
            wave = w
    return idx, wave


def load_song(path):
    """
    Returns dict:
      {
        'tempo': float,
        'volume': float,                 # master
        'tracks': [
            {'index': 1, 'wave': 'PULSE', 'volume': None or float,
             'notes': [(note, divider), ...]},
            ...
        ]
      }

    Files with NO 'TRACK' line are treated as one PULSE track at master volume.
    JSON format still supported for backwards compat (one track).
    """
    with open(path, "r") as f:
        content = f.read()

    tempo = 220.0
    volume = 0.01
    tracks = []
    cur = None  # currently-being-filled track

    stripped = content.strip()
    if stripped.startswith("{"):
        data = json.loads(stripped)
        tempo = float(data.get("tempo", tempo))
        volume = float(data.get("volume", volume))
        notes = [(str(n).upper(), float(d)) for n, d in data.get("melody", [])]
        tracks.append({"index": 1, "wave": "PULSE", "volume": None, "notes": notes})
        return {"tempo": tempo, "volume": volume, "tracks": tracks}

    for raw in content.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        key = parts[0].upper()

        if key == "TEMPO" and len(parts) >= 2:
            try:
                tempo = float(parts[1])
            except ValueError:
                pass
        elif key == "VOLUME" and len(parts) >= 2:
            try:
                v = float(parts[1])
            except ValueError:
                continue
            if cur is None:
                volume = v          # before any TRACK -> master volume
            else:
                cur["volume"] = v   # inside a track -> per-track volume
        elif key == "TRACK":
            idx, wave = _coerce_track(parts)
            cur = {"index": idx, "wave": wave, "volume": None, "notes": []}
            tracks.append(cur)
        elif len(parts) >= 2:
            # A note line: may contain multiple "NOTE DIVIDER" pairs.
            if cur is None:
                cur = {"index": 1, "wave": "PULSE", "volume": None, "notes": []}
                tracks.append(cur)
            # Walk pairs: even indices are notes, odd indices are dividers.
            i = 0
            while i < len(parts) - 1:
                note = parts[i].upper()
                try:
                    divider = float(parts[i + 1])
                except ValueError:
                    # Unparseable - bail out for the rest of this line
                    break
                cur["notes"].append((note, divider))
                i += 2
        else:
            print(f"  ! ignoring line: {raw!r}", file=sys.stderr)

    # Empty file edge case - always return at least one (empty) track.
    if not tracks:
        tracks.append({"index": 1, "wave": "PULSE", "volume": None, "notes": []})

    return {"tempo": tempo, "volume": volume, "tracks": tracks}


# ============================================================
# Mixing
# ============================================================

def mix_song(song):
    """Render all tracks and mix to a stereo int16 buffer."""
    tempo = song["tempo"]
    master_vol = song["volume"]
    rendered = []

    # Render each non-empty track. Empty/no-notes tracks are skipped so they
    # don't count toward the active-voice scaling.
    for tr in song["tracks"]:
        if not tr["notes"]:
            continue
        vol = tr["volume"] if tr["volume"] is not None else master_vol
        rendered.append(render_track(tr["notes"], tempo, tr["wave"], vol))

    if not rendered:
        return np.zeros((1, 2), dtype=np.int16)

    # Mixing rule: if only one track is active, use it as-is (so old single-voice
    # songs sound IDENTICAL to before). With multiple tracks, scale by
    # 1/sqrt(N) - perceptually balanced, prevents clipping.
    n = len(rendered)
    max_len = max(len(r) for r in rendered)
    mix = np.zeros(max_len, dtype=np.float32)
    for r in rendered:
        mix[:len(r)] += r
    if n > 1:
        mix *= 1.0 / np.sqrt(n)

    # Final safety: hard limit anything that would clip (rare).
    np.clip(mix, -1.0, 1.0, out=mix)
    mono = (mix * 32767.0).astype(np.int16)
    return np.column_stack((mono, mono))


# ============================================================
# Playback
# ============================================================

def find_song_file(name):
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidates = [name]
    for ext in (".json", ".txt"):
        candidates.append(name + ext)
        candidates.append(os.path.join("songs", name + ext))
        candidates.append(os.path.join(script_dir, name + ext))
        candidates.append(os.path.join(script_dir, "songs", name + ext))
    for path in candidates:
        if os.path.isfile(path):
            return path
    return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("song")
    ap.add_argument("--tempo",  type=float, default=None,
                    help="override song tempo (BPM)")
    ap.add_argument("--volume", type=float, default=None,
                    help="override master volume (0.0 - 1.0)")
    args = ap.parse_args()

    path = find_song_file(args.song)
    if path is None:
        print(f"Song not found: {args.song}")
        sys.exit(2)

    print(f"Loading: {path}")
    song = load_song(path)
    if args.tempo  is not None: song["tempo"]  = args.tempo
    if args.volume is not None: song["volume"] = max(0.0, min(1.0, args.volume))

    tracks_info = ", ".join(
        f"#{t['index']}={t['wave']}({len(t['notes'])})"
        for t in song["tracks"] if t["notes"]
    ) or "(empty)"
    print(f"Tempo={song['tempo']}  Volume={song['volume']}  Tracks: {tracks_info}")

    print("Rendering...")
    stereo = mix_song(song)
    if stereo.shape[0] <= 1:
        print("Nothing to play.")
        return

    pygame.mixer.pre_init(SAMPLE_RATE, -16, 2, 512)
    pygame.init()
    try:
        sound = pygame.sndarray.make_sound(stereo)
        sound.play()
        # Wait, allowing Ctrl-C to interrupt
        duration_ms = int(stereo.shape[0] / SAMPLE_RATE * 1000)
        try:
            pygame.time.wait(duration_ms + 100)
        except KeyboardInterrupt:
            sound.stop()
            print("\nStopped.")
    finally:
        pygame.quit()


if __name__ == "__main__":
    main()
